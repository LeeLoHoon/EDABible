{
  "name": "edabible",
  "private": true,
  "version": "1.5.85",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:binder": "APP_TARGET=binder vite",
    "dev:all": "APP_TARGET=all vite",
    "build": "node scripts/build-target.mjs",
    "build:note": "npm run build:bible && APP_TARGET=note tsc -b && APP_TARGET=note vite build",
    "build:binder": "APP_TARGET=binder tsc -b && APP_TARGET=binder vite build --outDir dist-binder",
    "build:all": "npm run build:bible && APP_TARGET=all tsc -b && APP_TARGET=all vite build --outDir dist-all",
    "build:bible": "node scripts/build_public_bible_from_jsonl.mjs && node scripts/build_public_bible_from_jsonl.mjs --lang en",
    "import:msg-bible": "node scripts/import_msg_bible.mjs",
    "seed:supabase-bible": "node scripts/seed_supabase_bible.mjs",
    "pull:supabase-bible": "node scripts/pull_supabase_bible.mjs && npm run build:bible",
    "validate:bible": "node scripts/validate-bible.mjs",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.1",
    "dexie": "^4.4.3",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "pdfjs-dist": "^4.10.38",
    "perfect-freehand": "^1.2.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.16.0",
    "signature_pad": "^5.1.3",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "pg": "^8.21.0",
    "puppeteer-core": "^25.1.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0"
  }
}
